# Server Configuration
PORT=5000
NODE_ENV=development

# Supabase Configuration (Optional - fallback in-memory store active if not set)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# AI Provider Keys (AI Router pools and routes between available keys)
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

PROVIDER_B_API_KEY=
PROVIDER_C_API_KEY=
PROVIDER_D_API_KEY=

# Router Settings
AI_PROVIDER_DEFAULT=gemini-1
AI_COOLDOWN_SECONDS=60
